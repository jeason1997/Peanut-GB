+/* Draw only BG outside the native LCD. Coordinates wrap in the 256x256 map. */
+static void __gb_viewport_bg(struct gb_s *gb, uint16_t line)
+{
+	uint32_t x;
+	int32_t left = (gb->display.viewport_width - LCD_WIDTH) / 2;
+	int32_t top = (gb->display.viewport_height - LCD_HEIGHT) / 2;
+	uint8_t y = (uint8_t)((int32_t)line - top + gb->hram_io[IO_SCY]);
+	uint16_t map = ((gb->hram_io[IO_LCDC] & LCDC_BG_MAP) ?
+		VRAM_BMAP_2 : VRAM_BMAP_1) + (y >> 3) * 32;
+	for(x = 0; x < gb->display.viewport_width; x++)
+	{
+		uint8_t colour = 0;
+		if(gb->hram_io[IO_LCDC] & LCDC_BG_ENABLE)
+		{
+			uint8_t bx = (uint8_t)((int32_t)x - left + gb->hram_io[IO_SCX]);
+			uint8_t idx = gb->vram[map + (bx >> 3)];
+			uint16_t tile = (gb->hram_io[IO_LCDC] & LCDC_TILE_SELECT) ?
+				VRAM_TILES_1 + idx * 16 :
+				VRAM_TILES_2 + ((idx + 128) % 256) * 16;
+			uint8_t shift = 7 - (bx & 7);
+			tile += (y & 7) * 2;
+			colour = gb->display.bg_palette[((gb->vram[tile] >> shift) & 1) |
+				(((gb->vram[tile + 1] >> shift) & 1) << 1)];
+#if PEANUT_GB_12_COLOUR
+			colour |= LCD_PALETTE_BG;
+#endif
+		}
+		gb->display.viewport_row[x] = colour;
+	}
+	if(gb->display.viewport_background != NULL)
+		gb->display.viewport_background(gb, gb->display.viewport_row,
+			gb->display.viewport_width, -left, (int32_t)line - top);
+}
+
+static void __gb_viewport_line(struct gb_s *gb, const uint8_t *native)
+{
+	uint16_t top = (gb->display.viewport_height - LCD_HEIGHT) / 2;
+	uint16_t left = (gb->display.viewport_width - LCD_WIDTH) / 2;
+	uint16_t row = top + gb->hram_io[IO_LY];
+	uint32_t y;
+	/* Sample top margin with line 0 state, bottom margin with line 143 state. */
+	if(gb->hram_io[IO_LY] == 0)
+		for(y = 0; y < top; y++)
+		{
+			__gb_viewport_bg(gb, (uint16_t)y);
+			gb->display.viewport_draw_line(gb, gb->display.viewport_row, (uint16_t)y);
+		}
+	if(left || gb->display.viewport_width != LCD_WIDTH)
+		__gb_viewport_bg(gb, row);
+	memcpy(gb->display.viewport_row + left, native, LCD_WIDTH);
+	gb->display.viewport_draw_line(gb, gb->display.viewport_row, row);
+	if(gb->hram_io[IO_LY] == LCD_HEIGHT - 1)
+		for(y = row + 1; y < gb->display.viewport_height; y++)
+		{
+			__gb_viewport_bg(gb, (uint16_t)y);
+			gb->display.viewport_draw_line(gb, gb->display.viewport_row, (uint16_t)y);
+		}
+}
