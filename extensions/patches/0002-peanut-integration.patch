+/* Viewport pixels use the same shade/layer format as native LCD pixels. */
+static void viewport_draw_line(struct gb_s *gb, const uint8_t *pixels, uint16_t line)
+{
+	struct priv_t *priv = gb->direct.priv;
+	unsigned int x;
+	uint8_t composed[160];
+	unsigned int left = (priv->width - 160) / 2, top = (priv->height - 144) / 2;
+	int native_row = line >= top && line < top + 144;
+	if(native_row)
+	{
+		memcpy(composed, pixels + left, sizeof(composed));
+		pgb_silver_jp_foreground(&priv->silver, gb, composed, line - top);
+	}
+	for(x = 0; x < priv->width; x++)
+	{
+		uint8_t colour = native_row && x >= left && x < left + 160 ? composed[x - left] : pixels[x];
+		priv->fb[(size_t)line * priv->width + x] = priv->selected_palette
+			[(colour & LCD_PALETTE_ALL) >> 4][colour & 3];
+	}
+}
