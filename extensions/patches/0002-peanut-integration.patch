+	SDL_Texture *next = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_RGB555,
+		SDL_TEXTUREACCESS_STREAMING, width, height);
+	if(next == NULL)
+		return -1;
+	SDL_DestroyTexture(*texture);
+	*texture = next;
+	priv->width = width;
+	priv->height = height;
+	memset(priv->fb, 0, (size_t)width * height * sizeof(*priv->fb));
+	pgb_silver_jp_viewport(&priv->silver, width, height);
+	gb_set_lcd_viewport(gb, width, height, priv->viewport_row, viewport_draw_line);
+	SDL_RenderSetLogicalSize(renderer, width, height);
+	SDL_SetWindowMinimumSize(priv->win, width, height);
+	SDL_SetWindowSize(priv->win, width, height);
